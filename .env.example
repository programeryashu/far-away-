HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
ORIGINS=http://localhost:5173
DATABASE_PATH=./data/orbit.db

# Shared Moment AI — OPTIONAL. Leave AI_PROVIDER as "none" (or the key empty)
# to use the built-in deterministic recommendations. The key lives ONLY here,
# server-side — never in the React bundle or browser storage.
AI_PROVIDER=none        # "openai" enables the LLM refinement path
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# Watch metadata (TMDB) — OPTIONAL. Discovery, metadata, and regional
# availability only; Orbit never streams or hosts titles. Without a key the
# watch APIs answer "unconfigured" and the UI says search is unavailable.
# The key lives ONLY here, server-side — it never reaches the browser bundle,
# localStorage, or any client payload.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_URL=https://image.tmdb.org/t/p
